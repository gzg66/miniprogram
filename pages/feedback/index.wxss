.wrap { padding: 28rpx 24rpx 70rpx; min-height: 100vh; background: var(--bg); color: var(--text); }
.head { display:flex; align-items:center; justify-content:space-between; margin-bottom:22rpx; }
.title { font-size:36rpx; font-weight:700; }
.back { color:var(--primary-deep); font-size:27rpx; padding:10rpx 18rpx; border:1rpx solid var(--border); border-radius:999rpx; background:var(--card); }
.card { background:var(--card); border:1rpx solid var(--border); border-radius:22rpx; padding:28rpx; }
.label { font-size:28rpx; font-weight:600; margin:4rpx 0 14rpx; }
.chips { display:flex; flex-wrap:wrap; gap:14rpx; margin-bottom:24rpx; }
.chip { color:var(--muted); background:var(--card-soft); border-radius:999rpx; padding:10rpx 22rpx; font-size:26rpx; }
.chip.on { color:#fff; background:var(--primary); }
.input, .textarea { width:100%; box-sizing:border-box; color:var(--text); background:var(--card-soft); border:1rpx solid var(--border); border-radius:14rpx; padding:20rpx; font-size:28rpx; margin-top:16rpx; }
.input { height:82rpx; }
.textarea { min-height:300rpx; }
.message { color:var(--freq-high); min-height:42rpx; padding-top:14rpx; font-size:26rpx; }
.submit { color:#fff; background:var(--primary); border-radius:999rpx; margin-top:10rpx; }
.submit[disabled] { opacity:.6; }
.notice { margin-top:24rpx; padding:18rpx 22rpx; text-align:center; color:var(--muted); font-size:24rpx; background:var(--card); border:1rpx solid var(--border); border-radius:16rpx; }
