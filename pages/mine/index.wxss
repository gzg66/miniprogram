.wrap { padding: 24rpx; }
.wrap { padding: 28rpx 24rpx 48rpx; }
.block { background: var(--card); border: 1rpx solid var(--border); border-radius: 22rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 20rpx rgba(92,78,65,.05); }
.head { display: flex; justify-content: space-between; align-items: center; }
.name { font-size: 36rpx; font-weight: 700; }
.clear { font-size: 26rpx; color: var(--freq-high); }
.stat { font-size: 28rpx; color: var(--muted); margin: 16rpx 0; }
.sub { font-size: 28rpx; font-weight: 600; margin: 20rpx 0 10rpx; }
.li { font-size: 28rpx; color: var(--text); padding: 10rpx 0; }
.setting-row { display:flex; justify-content:space-between; align-items:center; background:var(--card); border:1rpx solid var(--border); border-radius:18rpx; padding:18rpx 24rpx; margin-bottom:16rpx; font-size:29rpx; }
.feedback-entry { background:var(--card); border:1rpx solid var(--border); border-radius:18rpx; padding:22rpx 24rpx; margin-bottom:22rpx; color:var(--primary-deep); font-size:29rpx; font-weight:600; }
.feedback-entry text { display:block; color:var(--muted); font-size:24rpx; font-weight:400; margin-top:6rpx; }
