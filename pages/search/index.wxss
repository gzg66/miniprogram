.wrap { padding: 28rpx 24rpx 48rpx; }
.search { display: block; width: 100%; height: 80rpx; box-sizing: border-box; background: var(--card); border: 1rpx solid var(--border); border-radius: 999rpx; padding: 0 28rpx; line-height: 80rpx; margin-bottom: 20rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.search-placeholder { color: var(--muted); line-height: 80rpx; }
.filters { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.f { font-size: 26rpx; color: var(--muted); padding: 8rpx 20rpx; background: var(--card); border-radius: 999rpx; }
.f.on { color: #fff; background: var(--primary); }
.row { background: var(--card); border: 1rpx solid var(--border); border-radius: 18rpx; padding: 24rpx; margin-bottom: 14rpx; box-shadow: 0 7rpx 18rpx rgba(92,78,65,.04); }
.r1 { display: flex; justify-content: space-between; gap: 12rpx; }
.t { font-size: 32rpx; font-weight: 600; flex: 1; }
.r2 { font-size: 24rpx; color: var(--muted); margin-top: 8rpx; }
.r3 { font-size: 26rpx; line-height: 1.65; color: var(--secondary); margin-top: 10rpx; }
.empty { text-align: center; color: var(--muted); padding: 60rpx 0; }
.source-note { color: var(--secondary); font-size: 24rpx; margin: 0 4rpx 18rpx; }
.web-btn { display: inline-block; margin-top: 24rpx; color: #fff; background: var(--primary); border-radius: 999rpx; font-size: 26rpx; padding: 0 28rpx; }
