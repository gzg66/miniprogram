/* packageFilm/pages/timeline/index.wxss —— Morandi 年份背诵卡 */
.wrap { padding: 24rpx 24rpx 80rpx; }
.title { font-size: 38rpx; font-weight: 700; color: var(--text); }
.sub { font-size: 24rpx; color: var(--muted); margin-top: 8rpx; line-height: 1.7; }
.mode-switch { display: flex; background: var(--card); padding: 6rpx; border-radius: 999rpx; margin: 20rpx 0 12rpx; }
.mode { flex: 1; text-align: center; padding: 13rpx 0; border-radius: 999rpx; font-size: 25rpx; color: var(--muted); }
.mode.on { color: #FFFFFF; background: var(--primary); font-weight: 600; }
.ipt { height: 76rpx; background: var(--card); border-radius: 14rpx; padding: 0 24rpx; font-size: 28rpx; margin: 0 0 12rpx; color: var(--text); }
.chips { display: flex; flex-wrap: wrap; margin-bottom: 8rpx; }
.chip { padding: 10rpx 22rpx; margin: 0 12rpx 12rpx 0; background: var(--card); border-radius: 999rpx; font-size: 24rpx; color: var(--muted); }
.chip.on { background: var(--primary); color: #FFFFFF; }
.chip.ghost { color: var(--freq-high); }
.count { font-size: 24rpx; color: var(--muted); margin: 4rpx 0 16rpx; }
.year-card { background: rgba(255,255,255,.46); border: 1rpx solid rgba(125,122,132,.16); border-radius: 20rpx; padding: 16rpx; margin-bottom: 18rpx; }
.year-head { display: flex; align-items: center; justify-content: space-between; padding: 4rpx 8rpx 14rpx; }
.year-big { font-size: 48rpx; line-height: 1; font-weight: 750; color: var(--freq-high); letter-spacing: 1rpx; }
.year-count { font-size: 22rpx; color: var(--muted); }
.memory-card { background: var(--card); border-radius: 16rpx; padding: 22rpx; margin-bottom: 12rpx; box-shadow: 0 5rpx 18rpx rgba(80,74,84,.05); }
.memory-card:last-child { margin-bottom: 0; }
.tag-row { display: flex; align-items: center; flex-wrap: wrap; }
.cty { display: inline-block; font-size: 23rpx; color: var(--secondary); background: var(--soft); border-radius: 999rpx; padding: 5rpx 12rpx; margin-right: 10rpx; }
.place { font-size: 24rpx; color: var(--muted); line-height: 1.65; }
.mv { font-size: 30rpx; font-weight: 650; color: var(--text); margin-top: 12rpx; line-height: 1.45; }
.label { font-size: 22rpx; color: var(--freq-high); margin-top: 14rpx; }
.line, .claim { font-size: 25rpx; color: var(--text); line-height: 1.7; margin-top: 7rpx; }
.claim { color: var(--secondary); }
.memory { font-size: 24rpx; color: var(--primary); line-height: 1.65; background: var(--soft); border-radius: 10rpx; padding: 10rpx 12rpx; margin-top: 12rpx; }
.src { font-size: 22rpx; color: var(--muted); margin-top: 9rpx; }
.axis { font-size: 30rpx; font-weight: 700; color: var(--secondary); margin: 20rpx 0 12rpx; }
.card { background: var(--card); border-radius: 16rpx; padding: 22rpx; margin-bottom: 14rpx; }
.row { display: flex; align-items: baseline; }
.year { font-size: 34rpx; font-weight: 700; color: var(--freq-high); margin-right: 14rpx; }
.row .cty { background: transparent; padding: 0; }
.row .mv { margin-top: 0; }
.empty { text-align: center; color: var(--muted); background: var(--card); border-radius: 16rpx; padding: 34rpx 20rpx; }
.notice { margin-top: 32rpx; padding: 20rpx 24rpx; text-align: center; font-size: 24rpx; color: var(--muted); background: var(--card); border-radius: 16rpx; }
