.wrap{min-height:100vh;background:#F5F3EF;padding:28rpx 28rpx 70rpx;color:#48443F}.head{display:flex;align-items:center;justify-content:space-between;margin-bottom:22rpx}.title{font-size:40rpx;font-weight:700}.back{font-size:26rpx;color:#8A9A8B}.policy{background:#FBFAF7;border:1rpx solid #E7E0D8;border-radius:20rpx;padding:22rpx;color:#918A82;font-size:25rpx;line-height:1.7}.tabs{display:flex;gap:14rpx;margin:22rpx 0;flex-wrap:wrap}.tab{padding:14rpx 24rpx;border:1rpx solid #E7E0D8;border-radius:999rpx;background:#FBFAF7;color:#918A82}.tab.on{background:#87998B;color:#fff;border-color:#87998B}.count{color:#918A82;font-size:24rpx;margin-bottom:18rpx}.item{background:#FBFAF7;border:1rpx solid #E7E0D8;border-left:8rpx solid #87998B;border-radius:20rpx;padding:26rpx 24rpx;margin-bottom:20rpx}.type{display:inline-block;color:#fff;background:#87998B;border-radius:999rpx;padding:6rpx 14rpx;font-size:22rpx;margin-bottom:12rpx}.question{font-size:32rpx;font-weight:700;line-height:1.5}.source{color:#A9685E;font-size:24rpx;line-height:1.6;margin:10rpx 0}.tap-hint{color:#8A9A8B;font-size:24rpx;margin-top:16rpx}.detail-title{background:#FBFAF7;border:1rpx solid #E7E0D8;border-radius:20rpx;padding:26rpx 24rpx;margin-bottom:18rpx}.detail-title .question{display:block;margin-top:8rpx}.subhead{font-weight:700;color:#6F8275;margin:20rpx 0 10rpx}.answer{font-size:28rpx;line-height:1.75;margin-bottom:12rpx;white-space:pre-wrap;word-break:break-all}.chips{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:18rpx}.chip{font-size:23rpx;color:#A9685E;background:#F3E5E0;border-radius:999rpx;padding:8rpx 14rpx}
.directory-note{color:#918A82;font-size:25rpx;margin:18rpx 4rpx}.chapter{display:flex;justify-content:space-between;align-items:center;background:#FBFAF7;border:1rpx solid #E7E0D8;border-radius:18rpx;padding:28rpx 24rpx;margin-bottom:14rpx;font-size:30rpx}.cnt{color:#918A82;font-size:25rpx}.chapter-title{font-size:34rpx;font-weight:700;color:#6F8275;margin:22rpx 0 14rpx}
