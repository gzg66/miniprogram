.wrap { padding: 24rpx 24rpx 120rpx; }
.wrap { padding: 28rpx 24rpx 48rpx; }
.bar { display: flex; justify-content: space-between; align-items: center; color: var(--muted); font-size: 26rpx; }
.q { font-size: 40rpx; font-weight: 700; margin: 28rpx 0 10rpx; letter-spacing: 1rpx; }
.tip { font-size: 24rpx; color: var(--muted); margin-bottom: 24rpx; }
.drill-fav { display: inline-block; padding: 10rpx 20rpx; border: 1rpx solid var(--border); border-radius: 999rpx; color: var(--muted); margin-bottom: 14rpx; }
.drill-fav.on { color: var(--primary-deep); background: rgba(135,153,139,.14); border-color: var(--primary); }
.act { text-align: center; padding: 27rpx; border-radius: 999rpx; background: var(--primary); color: #fff; margin: 26rpx 0; box-shadow: 0 8rpx 18rpx rgba(111,130,117,.16); }
.judge { display: flex; gap: 16rpx; }
.j { flex: 1; text-align: center; padding: 24rpx; border-radius: 16rpx; color: #fff; }
.j.no { background: var(--freq-high); }
.j.yes { background: var(--primary-deep); }
.empty, .result { text-align: center; color: var(--muted); padding: 80rpx 20rpx; }
.result-title { font-size: 40rpx; color: var(--text); font-weight: 700; margin-bottom: 16rpx; }
.result-line { font-size: 30rpx; margin-bottom: 32rpx; }
