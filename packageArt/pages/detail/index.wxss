.wrap { padding: 28rpx 24rpx 170rpx; }
.back-catalog { display: inline-block; color: var(--primary-deep); font-size: 26rpx; padding: 10rpx 18rpx; border: 1rpx solid var(--border); border-radius: 999rpx; background: var(--card); margin-bottom: 18rpx; }
.head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.chapter { font-size: 24rpx; color: var(--muted); }
.detail-progress { color: var(--muted); font-size: 24rpx; margin: 8rpx 0 12rpx; }
.q { font-size: 40rpx; font-weight: 700; margin: 16rpx 0 26rpx; letter-spacing: 1rpx; }
.answer-toggle { text-align: center; padding: 24rpx; margin: 18rpx 0; border-radius: 18rpx; background: var(--card-soft); color: var(--primary-deep); font-size: 30rpx; border: 1rpx solid var(--border); }
.answer-toggle.secondary { padding: 14rpx; font-size: 25rpx; margin-top: 10rpx; }
.ops { display: flex; gap: 16rpx; position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 24rpx; background: rgba(251,250,247,.96); border-top: 1rpx solid var(--border); box-shadow: 0 -8rpx 20rpx rgba(92,78,65,.06); }
.op { flex: 1; text-align: center; padding: 20rpx; border-radius: 999rpx; background: var(--card-soft); color: var(--primary-deep); font-size: 28rpx; border: 1rpx solid var(--border); }
.op.on { background: var(--primary); color: #fff; border-color: var(--primary); }
.annotation-tip { color: var(--muted); font-size: 24rpx; margin: 0 0 12rpx; }
.note-box { background: var(--card-soft); border: 1rpx solid var(--border); border-radius: 18rpx; padding: 22rpx; margin: 20rpx 0 26rpx; }
.note-title { display:block; color: var(--primary-deep); font-weight:700; font-size:28rpx; margin-bottom:8rpx; }
.note-content { display:block; color:var(--text); font-size:27rpx; line-height:1.7; white-space:pre-wrap; }
