.wrap { padding: 28rpx 24rpx 48rpx; }
.list-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.list-title { font-size: 38rpx; font-weight: 700; color: var(--primary-deep); }
.back-home { color: var(--primary-deep); font-size: 26rpx; padding: 10rpx 18rpx; border: 1rpx solid var(--border); border-radius: 999rpx; background: var(--card); }
.tabs { display: flex; background: rgba(251,250,247,.84); border: 1rpx solid var(--border); border-radius: 18rpx; overflow: hidden; margin-bottom: 22rpx; }
.tab { flex: 1; text-align: center; padding: 22rpx; font-size: 30rpx; color: var(--muted); }
.tab.on { color: var(--primary-deep); font-weight: 700; box-shadow: inset 0 -5rpx 0 var(--primary); }
.chapter { display: flex; justify-content: space-between; background: var(--card); border: 1rpx solid var(--border); border-radius: 18rpx; padding: 28rpx; margin-bottom: 14rpx; box-shadow: 0 7rpx 18rpx rgba(92,78,65,.04); }
.chapter-right { display: flex; align-items: center; gap: 14rpx; }
.framework-link { color: var(--primary-deep); font-size: 24rpx; padding: 6rpx 12rpx; border-radius: 999rpx; background: rgba(135,153,139,.12); }
.cnt { color: var(--muted); font-size: 26rpx; }
.filters { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.f { font-size: 26rpx; color: var(--muted); padding: 8rpx 20rpx; background: var(--card); border-radius: 999rpx; }
.f.on { color: #fff; background: var(--primary); }
.drill-filter-label { color: var(--muted); font-size: 25rpx; margin: 4rpx 0 10rpx; }
.drill-filters { flex-wrap: wrap; }
.mode { background: var(--card); border: 1rpx solid var(--border); border-radius: 18rpx; padding: 28rpx; margin-bottom: 16rpx; box-shadow: 0 7rpx 18rpx rgba(92,78,65,.04); }
.mode-name { font-size: 32rpx; font-weight: 600; }
.mode-desc { font-size: 26rpx; color: var(--muted); margin-top: 8rpx; }
.search { display:block; width:100%; height:82rpx; box-sizing:border-box; background:var(--card); color:var(--text); border:1rpx solid var(--border); border-radius:999rpx; padding:0 28rpx; font-size:28rpx; line-height:normal; white-space:nowrap; overflow:hidden; }
.search-placeholder { color:var(--muted); font-size:28rpx; line-height:82rpx; }

.paper-entry { background: var(--card); border: 1rpx solid var(--border); border-radius: 18rpx; padding: 25rpx; margin-bottom: 20rpx; color: var(--primary-deep); font-size: 30rpx; text-align: center; }
.framework-entry { display: flex; justify-content: space-between; align-items: center; background: linear-gradient(120deg, rgba(135,153,139,.18), rgba(199,174,134,.16)); border: 1rpx solid rgba(135,153,139,.30); border-radius: 18rpx; padding: 25rpx; margin-bottom: 20rpx; color: var(--primary-deep); font-size: 30rpx; font-weight: 600; }
.framework-entry text { color: var(--muted); font-size: 23rpx; font-weight: 400; }
.framework-entry.compact { margin-top: 4rpx; font-size: 28rpx; }
